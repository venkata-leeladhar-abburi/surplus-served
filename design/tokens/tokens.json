{
  "$meta": {
    "name": "Surplus → Served Design System",
    "version": "1.0.0",
    "source": "Surplus-> Served.pdf — Design System v1.0 (sections 01–12)",
    "description": "Single source of truth. All platform themes (Flutter, Next.js/MUI, CSS) are generated from this file. Never hand-edit generated output.",
    "tagline": "Good food lives on.",
    "brandStatement": "Good food should keep moving."
  },

  "color": {
    "brand": {
      "leafGreen":     { "value": "#1F6B4A", "role": "Primary",    "desc": "Core brand colour. Nature, health, positive action." },
      "sageGreen":     { "value": "#4CAF7A", "role": "Secondary",  "desc": "Lighter, friendly green for secondary use and highlights." },
      "harvestOrange": { "value": "#E39A1F", "role": "Accent",     "desc": "Energy, hope and the joy of sharing food." },
      "tomatoRed":     { "value": "#C2402B", "role": "Alert",      "desc": "Alerts, important actions and emphasis." },
      "sunriseYellow": { "value": "#F6C453", "role": "Highlight",  "desc": "Warm highlight, paired with Harvest Orange." },
      "earthBrown":    { "value": "#6B4F3B", "role": "Neutral",    "desc": "Grounded warm neutral for imagery and illustration." }
    },

    "green": {
      "900": "#0E3D2C",
      "700": "#1F6B4A",
      "500": "#4CAF7A",
      "300": "#A7D5B9",
      "100": "#E6F3EC",
      "50":  "#F4FAF7"
    },

    "neutral": {
      "ink":        { "value": "#15211B", "desc": "Primary text colour." },
      "inkSoft":    { "value": "#4A574F", "desc": "Secondary text." },
      "surface":    { "value": "#FAFBF7", "desc": "Main background." },
      "surfaceAlt": { "value": "#F2F4EE", "desc": "Secondary surface." },
      "border":     { "value": "#D9E1D6", "desc": "Dividers and borders." },
      "muted":      { "value": "#A3B1A7", "desc": "Disabled text and icons." },
      "white":      { "value": "#FFFFFF", "desc": "Pure white for cards on tinted grounds." }
    },

    "semantic": {
      "success": { "value": "#16A34A", "onContainer": "#107D38", "desc": "Completed actions, positive feedback.", "uiCopy": "Food saved!" },
      "error":   { "value": "#DC2626", "onContainer": "#D32424", "desc": "Errors, issues and critical alerts.",   "uiCopy": "Something went wrong" },
      "warning": { "value": "#D97706", "onContainer": "#A95C04", "desc": "Caution and important notices.",        "uiCopy": "Check this" },
      "info":    { "value": "#2563EB", "onContainer": "#2563EB", "desc": "Informational messages.",               "uiCopy": "Here's something" },
      "focus":   { "value": "#7C3AED", "onContainer": "#7C3AED", "desc": "Focus states and interactive elements.", "uiCopy": "You're on track" }
    },

    "gradient": {
      "nature":  { "from": "#1F6B4A", "to": "#4CAF7A", "desc": "Hero sections, CTAs, key highlights." },
      "sunrise": { "from": "#E39A1F", "to": "#F6C453", "desc": "Accents, illustrations, special highlights." }
    },

    "combination": {
      "primary": { "colors": ["#1F6B4A", "#A7D5B9", "#E6F3EC"], "meaning": "Trust and nature." },
      "warm":    { "colors": ["#E39A1F", "#F6DFB4", "#FDF3E2"], "meaning": "Energy and optimism." },
      "alert":   { "colors": ["#C2402B", "#F6D2CC", "#FDECEA"], "meaning": "Attention when needed." },
      "cool":    { "colors": ["#2563EB", "#C7D7FD", "#EAF0FE"], "meaning": "Information and clarity." }
    },

    "$rules": [
      "Use colour with purpose, not decoration.",
      "Maintain sufficient contrast (WCAG 2.2 AA).",
      "Be consistent across all platforms.",
      "Combine colour with text or icons — never colour alone.",
      "Use semantic colours for status and feedback.",
      "Test in both light and dark environments."
    ]
  },

  "typography": {
    "family": {
      "primary":   { "name": "Inter", "desc": "Clean, modern and highly readable for all digital experiences.", "usage": "All interface text, labels, buttons, body copy." },
      "secondary": { "name": "Lora",  "desc": "A warm, expressive serif for headings and special content.",     "usage": "Impactful headlines, pull quotes, brand statements." }
    },
    "weights": { "regular": 400, "medium": 500, "semibold": 600, "bold": 700 },
    "scale": {
      "h1":      { "family": "Inter", "weight": 700, "size": 56, "lineHeight": 1.2,  "sample": "The food we save today feeds a brighter tomorrow." },
      "h2":      { "family": "Inter", "weight": 600, "size": 40, "lineHeight": 1.2,  "sample": "Good food brings people together." },
      "h3":      { "family": "Inter", "weight": 600, "size": 32, "lineHeight": 1.2,  "sample": "Stronger communities, less waste." },
      "h4":      { "family": "Inter", "weight": 500, "size": 24, "lineHeight": 1.3,  "sample": "Fresh food. Real impact." },
      "h5":      { "family": "Inter", "weight": 500, "size": 20, "lineHeight": 1.4,  "sample": "Small actions create big change." },
      "body":    { "family": "Inter", "weight": 400, "size": 16, "lineHeight": 1.6,  "sample": "Food connects us all." },
      "small":   { "family": "Inter", "weight": 400, "size": 14, "lineHeight": 1.6,  "sample": "Together, we can make sure good food always finds a home." },
      "caption": { "family": "Inter", "weight": 400, "size": 12, "lineHeight": 1.6,  "sample": "Pick up · Share · Nourish" },
      "display": { "family": "Lora",  "weight": 500, "size": 40, "lineHeight": 1.25, "sample": "Good food should be shared, not wasted." },
      "quote":   { "family": "Lora",  "weight": 400, "size": 20, "lineHeight": 1.5,  "italic": true, "sample": "A kinder tomorrow is written in the choices we make today." }
    },
    "$rules": [
      "Left align — easiest to read and more accessible.",
      "Generous line height — 160% for body.",
      "Optimal line length — keep text between 45–75 characters.",
      "Use the defined type scale.",
      "Maintain consistent font weights.",
      "Don't use too many font styles.",
      "Don't use ALL CAPS for long text.",
      "Don't stretch or distort type."
    ]
  },

  "spacing": {
    "$base": 4,
    "xs": 4, "sm": 8, "md": 12, "lg": 16, "xl": 24, "xxl": 32, "xxxl": 40, "huge": 56, "mega": 72,
    "screenPadding": 16,
    "cardPadding": 16,
    "sectionGap": 24
  },

  "radius": {
    "xs": 4, "sm": 8, "md": 12, "lg": 16, "xl": 24, "pill": 999
  },

  "elevation": {
    "none": { "y": 0, "blur": 0,  "spread": 0, "color": "#15211B", "opacity": 0.00 },
    "sm":   { "y": 1, "blur": 2,  "spread": 0, "color": "#15211B", "opacity": 0.05 },
    "md":   { "y": 2, "blur": 8,  "spread": 0, "color": "#15211B", "opacity": 0.06 },
    "lg":   { "y": 6, "blur": 20, "spread": 0, "color": "#15211B", "opacity": 0.08 },
    "xl":   { "y": 12,"blur": 32, "spread": 0, "color": "#15211B", "opacity": 0.10 }
  },

  "iconography": {
    "strokeWidth": 2,
    "cap": "round",
    "join": "round",
    "sizes": { "xs": 16, "sm": 20, "md": 24, "lg": 32, "xl": 48 },
    "grid": 24,
    "variants": ["outline", "filled"],
    "core": ["home","search","addFood","donate","receive","map","calendar","bell","message","user","leaf","truck","package","share","settings"],
    "category": ["food","fruitsVeg","bakery","meals","beverages","dairy","restaurants","cafes","grocery","events","community","impact","wasteReduction","recycle","verified","time","location","help"],
    "$rules": [
      "Use consistent stroke width.",
      "Keep it simple and recognizable.",
      "Use rounded corners.",
      "Don't use detailed icons.",
      "Don't mix different styles.",
      "Don't stretch, distort or dot/dashify.",
      "Don't use low contrast."
    ]
  },

  "motion": {
    "duration": { "instant": 100, "fast": 150, "normal": 250, "slow": 400, "deliberate": 600 },
    "easing": {
      "standard":  [0.2, 0.0, 0.0, 1.0],
      "decelerate":[0.0, 0.0, 0.2, 1.0],
      "accelerate":[0.4, 0.0, 1.0, 1.0]
    }
  },

  "breakpoints": { "xs": 0, "sm": 600, "md": 905, "lg": 1240, "xl": 1440 },

  "accessibility": {
    "standard": "WCAG 2.2 AA",
    "alsoTargets": ["ADA", "EN 301 549", "Section 508"],
    "minTapTarget": 44,
    "minContrastBodyText": 4.5,
    "minContrastLargeText": 3.0,
    "textScaleMax": 2.0,
    "focusRing": { "width": 2, "offset": 2, "color": "#7C3AED" },
    "$rules": [
      "Logical tab order.",
      "Visible focus indicators.",
      "All interactive elements accessible.",
      "Skip to main content link (web).",
      "Meaningful alt text for images.",
      "Clear and descriptive link and button text.",
      "Meaning is never conveyed by colour alone."
    ]
  },

  "locale": {
    "supported": ["en", "te"],
    "default": "en",
    "note": "Scope doc §14 — full English/Telugu parity across every screen, push notification and SMS. Design system §10 shows further languages as a future growth path only."
  },

  "status": {
    "$note": "Donation lifecycle from Scope doc §7. Badge colour + icon are both required — never colour alone. `color` is the brand hue for fills and dots; `text` is the AA-verified (>=4.5:1) tone for label and icon on `surface`.",
    "draft":       { "color": "#A3B1A7", "text": "#68716A", "surface": "#F2F4EE", "icon": "edit",        "labelEn": "Draft" },
    "pendingCheck":{ "color": "#D97706", "text": "#A95C04", "surface": "#FDF3E2", "icon": "time",   "labelEn": "Under review" },
    "live":        { "color": "#16A34A", "text": "#107D38", "surface": "#E6F3EC", "icon": "check", "labelEn": "Live" },
    "allocated":   { "color": "#2563EB", "text": "#2563EB", "surface": "#EAF0FE", "icon": "user",  "labelEn": "Allocated" },
    "collected":   { "color": "#1F6B4A", "text": "#1F6B4A", "surface": "#E6F3EC", "icon": "leaf",        "labelEn": "Collected" },
    "reallocated": { "color": "#D97706", "text": "#A95C04", "surface": "#FDF3E2", "icon": "refresh",     "labelEn": "Reallocated" },
    "unfulfilled": { "color": "#A3B1A7", "text": "#68716A", "surface": "#F2F4EE", "icon": "time",   "labelEn": "Unfulfilled" },
    "cancelled":   { "color": "#DC2626", "text": "#D32424", "surface": "#FDECEA", "icon": "close",    "labelEn": "Cancelled" },
    "rejected":    { "color": "#DC2626", "text": "#D32424", "surface": "#FDECEA", "icon": "alert",       "labelEn": "Rejected" },
    "urgent":      { "color": "#C2402B", "text": "#C2402B", "surface": "#FDECEA", "icon": "alert",       "labelEn": "Urgent" }
  },

  "voice": {
    "principles": [
      { "principle": "Clear over clever",              "example": "12 meals nearby" },
      { "principle": "Warm over sentimental",          "example": "Pickup in 18 min" },
      { "principle": "Action-oriented over alarmist",  "example": "Food saved" },
      { "principle": "Respectful over charity-centric","example": "You're helping it reach a table." }
    ],
    "weAre": ["Compassionate", "Action-oriented", "Transparent", "Community-driven"],
    "weAreNot": ["Judgmental", "Slow or passive", "Charity-centric", "Overly promotional"]
  }
}
